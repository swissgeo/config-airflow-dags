ICEBERG_BACKEND=local # set to s3tables on production

# local iceberg configuration
ICEBERG_URI=http://localhost:8181
AWS_ACCESS_KEY_ID=motoadmin
AWS_SECRET_ACCESS_KEY=motoadmin
AWS_ENDPOINT_URL=http://localhost:9090

# global AWS region setting
AWS_REGION=eu-central-1

# s3 Bucket configuration
RAW_TABLE_BUCKET_ARN=local/raw
SANITIZE_TABLE_BUCKET_ARN=local/sanitize
LOAD_TABLE_BUCKET_ARN=local/load
LANDING_ZONE_BUCKET=landing-zone

# Configuration of the service-oa-features database
FEATURES_DB_ENDPOINT=localhost
FEATURES_DB_PORT=5432
FEATURES_DB_NAME=postgres
FEATURES_DB_USER=postgres
FEATURES_DB_PASSWORD=postgres
FEATURES_DB_SSL_REQUIRED=False
