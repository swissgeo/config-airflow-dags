# Local Iceberg (docker-compose)
ICEBERG_REST_URI=http://localhost:8181
ICEBERG_WAREHOUSE=s3://warehouse/

AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password
AWS_REGION=eu-central-1
AWS_ENDPOINT_URL=http://localhost:9000

# Satisfy get_table_bucket_arn(); overridden by ICEBERG_WAREHOUSE above
RAW_TABLE_BUCKET_ARN=local/raw
SANITIZE_TABLE_BUCKET_ARN=local/sanitize
LOAD_TABLE_BUCKET_ARN=local/load
